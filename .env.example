# Copy to .env (repo root). The backend reads this file; secrets never reach the browser.

# --- LLM: OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
# Default model for every stage. Any OpenRouter model id with JSON output support.
OPENROUTER_MODEL=openai/gpt-5-mini
# Optional per-stage overrides (fall back to OPENROUTER_MODEL)
LLM_MODEL_EXTRACTION=
LLM_MODEL_CONVERSATION=
LLM_MODEL_SIMULATOR=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1800

# --- Speech: Sarvam AI (Saaras STT, Bulbul TTS) -------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_REST_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_AGENT_SPEAKER=priya
SARVAM_TTS_COUNTERPARTY_SPEAKER=rahul
SARVAM_TTS_SAMPLE_RATE=22050

# --- Persistence: Supabase -----------------------------------------------------
# `supabase start` prints these. Leave empty to use in-memory storage.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------------
# Force the labelled demo LLM even when a key is present.
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (frontend/.env.local) -----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
